{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "npm run dev -w @devmentor/app",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migration:create": "npm run db:migration:create -w @devmentor/db",
    "db:migrate": "npm run db:migrate -w @devmentor/db",
    "db:migration:list": "npm run db:migration:list -w @devmentor/db",
    "db:migration:down": "npm run db:migration:down -w @devmentor/db"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
